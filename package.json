{
  "name": "anon-editor",
  "version": "1.1.0",
  "private": true,
  "description": "Origin-free video export engine for Anon Editor",
  "main": "desktop/main.js",
  "scripts": {
    "anon": "node src/cli.js",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:phase1": "node --test test/phase1.test.js",
    "test:phase2": "node --test test/desktop.test.js",
    "test:phase3": "node --test test/timeline.test.js",
    "test:phase4": "node --test test/multitrack.test.js",
    "test:phase5": "node --test test/history-project.test.js",
    "test:phase6": "node --test test/export.test.js",
    "test:phase7": "node --test test/desktop.test.js test/multitrack.test.js test/export.test.js",
    "test:phase11": "node --test test/phase1.test.js",
    "test:phase12": "node --test test/phase12.test.js",
    "test:phase13": "node --test test/phase13.test.js",
    "test:phase14": "node --test test/phase14.test.js",
    "test:desktop:smoke": "electron . --smoke-test",
    "build:win": "node scripts/prepare-ffmpeg.js && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.anoneditor.desktop",
    "productName": "Anon Editor",
    "asar": true,
    "files": [
      "desktop/**/*",
      "src/**/*",
      "appicon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".build-tools/ffmpeg",
        "to": "tools",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "appicon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Anon Editor Setup ${version} ${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Anon Editor"
    },
    "portable": {
      "artifactName": "Anon Editor Portable ${version} ${arch}.${ext}"
    }
  }
}
